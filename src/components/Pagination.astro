---
import { getCollection } from 'astro:content';

const clean = (id: string) => id.replace(/\.mdx?$/, '').replace(/\/index$/, '');
const current = Astro.url.pathname.replace(/^\/|\/$/g, '');
const [cat, book, lang] = current.split('/');
const prefix = `${cat}/${book}/${lang}/`;

const list = (await getCollection('docs'))
  .filter((e) => !e.data.draft)
  .map((e) => ({ id: clean(e.id), title: e.data.title }))
  .filter((e) => e.id.startsWith(prefix) && e.id.split('/').length === 4)
  .sort((a, b) => a.id.localeCompare(b.id, 'en', { numeric: true }));

const i = list.findIndex((e) => e.id === current);
const prev = i > 0 ? list[i - 1] : undefined;
const next = i >= 0 && i < list.length - 1 ? list[i + 1] : undefined;
---

{(prev || next) && (
  <nav class="kk-pager" aria-label="บทก่อนหน้า/ถัดไป">
    {prev ? (
      <a class="kk-prev" href={`/${prev.id}/`}>
        <span>← ก่อนหน้า</span>
        <strong>{prev.title}</strong>
      </a>
    ) : <span />}
    {next ? (
      <a class="kk-next" href={`/${next.id}/`}>
        <span>ถัดไป →</span>
        <strong>{next.title}</strong>
      </a>
    ) : <span />}
  </nav>
)}

<style>
  .kk-pager { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 3rem; }
  a { display: flex; flex-direction: column; gap: 0.25rem; padding: 0.9rem 1.1rem; border: 1px solid var(--sl-color-gray-5); border-radius: 0.5rem; text-decoration: none; color: var(--sl-color-gray-2); }
  a:hover { border-color: var(--sl-color-text-accent); }
  a span { font-size: var(--sl-text-sm); color: var(--sl-color-gray-3); }
  a strong { font-size: var(--sl-text-base); color: var(--sl-color-white); }
  .kk-next { text-align: end; grid-column: 2; }
  .kk-prev { grid-column: 1; }
</style>